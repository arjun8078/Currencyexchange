# Primary (default): ExchangeRate-API — free tier = latest mid-market rates
# https://www.exchangerate-api.com/
EXCHANGE_RATE_API_KEY=

# Optional: Open Exchange Rates (historical often works better on paid/free trial)
# https://openexchangerates.org/signup
OPEN_EXCHANGE_RATES_APP_ID=

# exchangerateapi | openexchangerates | frankfurter | currencyapi | auto
FX_PROVIDER=exchangerateapi

DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
