# ExchangeRate-API (trying this first — free tier = latest rates)
# Sign up: https://www.exchangerate-api.com/ → copy your API key
EXCHANGE_RATE_API_KEY=

# Optional later: Open Exchange Rates (good for historical dates)
# https://openexchangerates.org/signup
OPEN_EXCHANGE_RATES_APP_ID=

# Provider: exchangerateapi | openexchangerates | frankfurter | currencyapi | auto
# auto = ExchangeRate-API if key set, else OXR if set, else community CDN
FX_PROVIDER=exchangerateapi

DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
