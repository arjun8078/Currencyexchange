# Optional: Open Exchange Rates app id (recommended for production).
# https://openexchangerates.org/signup
OPEN_EXCHANGE_RATES_APP_ID=

# Provider: auto | frankfurter | openexchangerates | currencyapi
# auto = Open Exchange Rates if key set, else free CurrencyAPI (supports AED + historical dates)
FX_PROVIDER=auto

DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
