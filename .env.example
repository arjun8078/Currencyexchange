# Primary (default): Open Exchange Rates — recommended for production
# https://openexchangerates.org/signup
OPEN_EXCHANGE_RATES_APP_ID=

# Budget / alternate: ExchangeRate-API
# https://www.exchangerate-api.com/
EXCHANGE_RATE_API_KEY=

# openexchangerates | exchangerateapi | frankfurter | currencyapi | auto
FX_PROVIDER=openexchangerates

DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
